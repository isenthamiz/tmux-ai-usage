#!/bin/bash
# Test double for curl. Records one line per call in $CURL_SHIM_LOG.
# Env: CURL_SHIM_RESPONSE, CURL_SHIM_EXIT, CURL_SHIM_DELAY, CURL_SHIM_HTTP, CURL_SHIM_RETRY_AFTER.
outfile="" hdrfile="" writefmt=0
args=("$@")
i=0
while [ $i -lt ${#args[@]} ]; do
  case "${args[$i]}" in
    -o) outfile="${args[$((i + 1))]}"; i=$((i + 2)) ;;
    -D) hdrfile="${args[$((i + 1))]}"; i=$((i + 2)) ;;
    -w) writefmt=1; i=$((i + 2)) ;;
    *) i=$((i + 1)) ;;
  esac
done
[ "${BASH_SUBSHELL:-0}" -eq 0 ] && [ -n "${CURL_SHIM_LOG:-}" ] && echo call >>"$CURL_SHIM_LOG"
sleep "${CURL_SHIM_DELAY:-0}"

if [ -n "$CURL_SHIM_EXIT" ]; then
  echo "curl: (${CURL_SHIM_EXIT}) simulated failure" >&2
  exit "$CURL_SHIM_EXIT"
fi

http="${CURL_SHIM_HTTP:-200}"
if [ -n "$hdrfile" ]; then
  {
    printf 'HTTP/1.1 %s\r\n' "$http"
    [ -n "${CURL_SHIM_RETRY_AFTER:-}" ] && printf 'Retry-After: %s\r\n' "$CURL_SHIM_RETRY_AFTER"
    printf '\r\n'
  } >"$hdrfile"
fi

url=""
i=0
while [ $i -lt ${#args[@]} ]; do
  case "${args[$i]}" in
    http*) url="${args[$i]}" ;;
  esac
  i=$((i + 1))
done

resp="${CURL_SHIM_RESPONSE:-}"
if [[ "$url" == *get-sand-usage-status* ]]; then
  resp="${CURL_SHIM_SAND_RESPONSE:-$resp}"
elif [[ "$url" == *usage-summary* ]]; then
  resp="${CURL_SHIM_SUMMARY_RESPONSE:-$resp}"
fi

body=""
if [ -n "$resp" ] && [ -r "$resp" ]; then
  body=$(cat "$resp")
fi
[ -n "$outfile" ] && printf '%s' "$body" >"$outfile"
[ "$writefmt" -eq 1 ] && printf '%s' "$http"
exit 0